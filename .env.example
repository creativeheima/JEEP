# ==========================================
# KONFIGURASI SUPABASE DATABASE
# ==========================================
# Dapatkan kredensial ini dari:
# https://supabase.com -> Masuk ke Project Anda -> Settings -> API

# URL Project Supabase Anda (contoh: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon Public Key (bisa diakses client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Secret (opsional, untuk bypass RLS di sisi server API jika diperlukan)
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# KEAMANAN LOGIN ADMIN (WAJIB DIISI)
# ==========================================
# String acak panjang untuk menandatangani sesi login (min. 32 karakter).
# Buat misalnya dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=

# Akun Superuser pertama — hanya dipakai bila BELUM ada akun sama sekali.
# Setelah login, ganti password & buat akun lain dari menu "Kelola Akun Admin".
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_EMAIL=

# Opsional: izinkan sertifikat SSL MySQL self-signed (default: diverifikasi)
# MYSQL_SSL_ALLOW_SELF_SIGNED=true

# Nomor WhatsApp admin (format 62xxx tanpa + / spasi) — dipakai tombol WA & pesan booking
NEXT_PUBLIC_WHATSAPP_NUMBER=
